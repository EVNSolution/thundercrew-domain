# 썬더크루 라이더 앱 환경변수 예시. 실제 값은 .env 에 넣는다(.env 는 gitignore).
# EXPO_PUBLIC_* 값만 네이티브 앱 런타임에 번들된다.

# 썬더크루 rider API 오리진(경로 없이 origin 만). 미설정 시 mock 모드(로그인 화면 유지).
# EXPO_PUBLIC_THUNDERCREW_SERVICE_OPS_BASE_URL=https://thcr.cleversystem.ai

# NCP Maps Client ID(= 웹과 동일 Maps 애플리케이션의 ncpKeyId). 네이티브 지도 인증용.
# NCP 콘솔에서 Mobile Dynamic Map 활성화 + Android 패키지/ iOS 번들(com.evns.cleverdriverapp) 등록 후 사용.
# EXPO_PUBLIC_NCP_MAP_CLIENT_ID=<ncp-maps-client-id>

# (레거시 delivery-server 예시 앱용 — MVP 미사용)
# EXPO_PUBLIC_DELIVERY_SERVER_BASE_URL=https://delivery.example.com
