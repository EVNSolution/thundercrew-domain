# 썬더크루 관리자 웹 (Vite SPA) 환경변수 예시
#
# 실제 값은 로컬 `.env.local` 또는 EC2 호스트 env 파일로만 관리한다.
# 이 파일에는 secret 을 넣지 않는다.

# 필수. "mock" 또는 "remote" 중 하나를 명시해야 하며 기본값이 없다.
# remote 요청 실패를 mock 데이터로 대체하지 않는다 (DSV 규칙과 동일).
VITE_TC_API_MODE=mock

# service-ops-api base path. 같은 오리진으로 프록시되는 것을 전제한다.
# 인증이 httpOnly 쿠키라서 크로스 오리진으로 두지 않는다.
VITE_TC_API_BASE_URL=/api/v1

# 로컬 개발에서 `/api` 를 어디로 프록시할지. 설정하면 dev/preview 서버가 프록시한다.
# VITE_TC_API_PROXY_TARGET=http://127.0.0.1:8080

# 시뮬레이션. 실차량 텔레메트리가 들어오기 전 지도에서 움직이는 핀을 보여준다.
# "1" / "true" / "yes" / "on" 만 켜진 것으로 친다. 비우면 정지된 핀만 보인다.
# 화면에는 항상 "시뮬레이션" 배지가 뜬다.
VITE_TC_SIMULATION=1

# 시뮬레이션 시간 가속 배율. 기본 60. 1 이면 실시간이라 지도에서 이동이 보이지 않는다.
VITE_TC_SIMULATION_SPEED=60
