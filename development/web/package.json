{
  "name": "@thundercrew/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "썬더크루 관리자 웹 (Vite SPA). 진입 모드 3갈래 — 배송용 / 클린차량 / 정비.",
  "scripts": {
    "dev": "cross-env VITE_TC_API_MODE=mock vite --host 0.0.0.0 --port 5175",
    "dev:remote": "cross-env VITE_TC_API_MODE=remote VITE_TC_API_PROXY_TARGET=http://127.0.0.1:8080 vite --host 0.0.0.0 --port 5175",
    "build": "tsc -p tsconfig.json --noEmit && cross-env VITE_TC_API_MODE=remote vite build",
    "build:mock": "tsc -p tsconfig.json --noEmit && cross-env VITE_TC_API_MODE=mock vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.7"
  }
}
